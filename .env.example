DEFAULT_CLINIC_NAME=The Pet Physio Vet Clinic
SECRET_KEY=django-insecure-test-secret-key-change-me-in-production
FCM_PROJECT_ID=test-fcm-project-id
FCM_SERVER_KEY=test-fcm-server-key-123456
MSG91_AUTH_KEY=test_msg91_auth_key
MSG91_SENDER_ID=PETVET
NOTIFY_FCM_PROVIDER=mock
