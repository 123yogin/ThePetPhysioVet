TWILIO_AUTH_TOKEN=test_twilio_auth_token_123456
TWILIO_FROM_NUMBER=+15005550006

# --- Docker Compose (docker-compose.yml) ------------------------------
# Consumed directly by `docker compose up` when bringing up the full
# containerized stack (postgres + backend + frontend). The DATABASE_URL
# above is for the plain `manage.py runserver` / sqlite local-dev workflow;
# inside docker compose the backend's DATABASE_URL is instead assembled
# from the POSTGRES_* values below and points at the `postgres` service.
#
# For an actual production deploy (not just a local docker smoke test),
# override at least: DEBUG=False, SECRET_KEY (a real random value — the
# placeholder above is rejected as too weak by `manage.py check --deploy`
# but is NOT rejected by the app itself, so don't ship it), and
# POSTGRES_PASSWORD. There is no baked-in POSTGRES_PASSWORD default —
# docker compose refuses to start without one.
POSTGRES_DB=petphysio
POSTGRES_USER=petphysio
POSTGRES_PASSWORD=change-me-strong-password

# Host port the frontend (nginx) container publishes. It is the only
# container exposed to the host network — backend and postgres are only
# reachable from other containers on the internal compose network.
HTTP_PORT=8080
