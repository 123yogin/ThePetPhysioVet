# ThePetPhysioVet backend — environment template.
# Copy to backend/.env and fill in real values. NEVER commit the real .env.
# Every var below is read by petphysio/settings.py; defaults shown are the
# in-code fallbacks. Secrets have EMPTY defaults and must be supplied in prod.

# --- Core Django ---
# Generate a fresh 50+ char random string for production. Do NOT ship the default.
DJANGO_SECRET_KEY=django-insecure-change-this-in-production
# "true" enables local dev behaviour (verbose errors, serves static/media).
DEBUG=false
# Comma-separated hostnames.
ALLOWED_HOSTS=.onrender.com,127.0.0.1,localhost

# --- Clinic defaults (shown on receipts / invoices) ---
DEFAULT_CLINIC_NAME=ThePetPhysioVet Clinic
DEFAULT_CLINIC_ADDRESS=

# --- Payments: Razorpay (SRS §3.8) ---
# RAZORPAY_MOCK truthy (default) uses the in-process mock; no real keys needed.
# Set RAZORPAY_MOCK=false and supply TEST keys to hit the real gateway.
RAZORPAY_MOCK=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Notifications & reminders (SRS §3.7) ---
# NOTIFY_MOCK truthy (default) routes SMS/push to the in-process mock providers.
NOTIFY_MOCK=true
NOTIFY_SMS_PROVIDER=appointments.delivery.mock.MockSmsProvider
NOTIFY_FCM_PROVIDER=appointments.delivery.mock.MockFcmProvider
# Real SMS providers (Twilio / MSG91) — only needed when NOTIFY_MOCK=false.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# Real FCM web-push credentials.
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# --- Production security (only applied when DEBUG=false) ---
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
# Comma-separated https origins allowed to submit CSRF-protected forms.
CSRF_TRUSTED_ORIGINS=

# --- UI-parity test harness (leave unset in normal dev/prod) ---
# PARITY_TODAY: ISO date to pin "today" for the Playwright parity check.
PARITY_TODAY=
# PARITY_MODE: truthy registers the parity-only shell route.
PARITY_MODE=
