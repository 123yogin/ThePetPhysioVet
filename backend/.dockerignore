# Never bake these into the image (CLAUDE.md rule 1: never commit secrets;
# tech-lead task 8).
.env
.env.*
!.env.example

# Local virtualenv / bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# Local SQLite DB (dev only — real deployments use DATABASE_URL/Postgres)
db.sqlite3
db.sqlite3-journal
db.sqlite3.bak*

# Build/runtime artifacts regenerated by collectstatic / uploads at runtime
staticfiles/
media/

# VCS / editor / OS cruft
.git/
.gitignore
.vscode/
.idea/
*.swp
.DS_Store

# Docs not needed inside the image
*.md
