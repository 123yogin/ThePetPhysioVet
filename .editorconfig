# EditorConfig — https://editorconfig.org
# Consistent whitespace across the Django backend and React/Vite frontend.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python (Django) uses 4-space indentation (PEP 8).
[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
